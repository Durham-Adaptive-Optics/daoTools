import os
import platform

# libstdc++fs only exists for GNU libstdc++ (pre-GCC 9); macOS links against
# libc++, which has had <filesystem> built in since C++17 support landed, so
# there is no such library to link against there.
daoDAQ_lib = ['dao', 'daoNuma', 'daoProto', 'pthread']
if platform.system() != "Darwin":
    daoDAQ_lib.append('stdc++fs')

bld.program(
    target='daoDAQ',
    source=bld.path.ant_glob('src/**/*.cpp'),

    includes=[
        'include',
        '../../include',
        f"{os.getenv('DAOROOT')}/include"
    ],

    libpath=[
        f"{os.getenv('DAOROOT')}/lib",
        f"{os.getenv('DAOROOT')}/lib64"
    ],

    lib=daoDAQ_lib,

    cxxflags=[
        '-O3',
        '-Wall',
        '-Wextra',
        '-pipe',
        '-fdiagnostics-color=always',
        '-std=c++17'
    ],

    use=[
        'daoTools',
        'CLI11',
        'cfitsio',
        'FMT',
        'ZMQ',
        'PROTOBUF',
        'YAMLCPP'
    ]
)
