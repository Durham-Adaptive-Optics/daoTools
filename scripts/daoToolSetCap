#!/bin/bash
# daoToolSetCap
# Grants the real-time capabilities (CAP_IPC_LOCK, CAP_SYS_NICE) needed by the
# RT loop binaries so they can mlockall() and run SCHED_FIFO without being root.
# Must be re-run (as root) after every rebuild/reinstall of these binaries,
# since file capabilities live on the binary's inode and are lost when it is
# replaced.
#
# A binary with file capabilities runs in secure mode: the loader ignores
# LD_LIBRARY_PATH, so $DAOROOT/lib must be known to ldconfig (a file in
# /etc/ld.so.conf.d/ listing it, then ldconfig), or the binary no longer starts.
# Without setcap, an rtprio and memlock limit for the user
# (/etc/security/limits.conf) gives the same.
#
# Usage: sudo ./daoToolSetCap

set -e

if [ "$(id -u)" -ne 0 ]; then
    echo "daoToolSetCap must be run as root, e.g.:"
    echo "  sudo $0"
    exit 1
fi

: "${DAOROOT:?DAOROOT is not set}"

BINARIES="daoMvM daoMvMGPU daoDescrambleOcam2 daoGpuPipeline"

if ! ldconfig -p | grep -q "libdao.so.0 "; then
    echo "Warning: libdao.so.0 is not in the ldconfig cache: with capabilities, these"
    echo "binaries ignore LD_LIBRARY_PATH and will not find it. List $DAOROOT/lib in"
    echo "/etc/ld.so.conf.d/dao.conf and run ldconfig."
fi

for bin in $BINARIES; do
    path="$DAOROOT/bin/$bin"
    if [ -f "$path" ]; then
        setcap cap_ipc_lock,cap_sys_nice+ep "$path"
        echo "Capabilities set on $path:"
        getcap "$path"
    else
        echo "Skipping $bin: not found at $path"
    fi
done
